#channel_sounder_kafka.conf
# Pipeline for Kafka --> Logstash --> Elastic

input {
  kafka {
    bootstrap_servers => "192.168.60.202:9092"
    topics => ["channel_sounder_logging"]
    codec => "json"  # Parses the entire Kafka message as JSON
    group_id => "logstash_consumer_group"
    auto_offset_reset => "earliest"
  }
}

filter {

  # Handle "radio_channelsounder[rx/tx]grc_log" logs separately and stop further processing
  if [log_type] == "radio_channelsoundertxgrc_log" or [log_type] == "radio_channelsounderrxgrc_log" {
    date {
      match => ["log_timestamp", "YYYY-MM-dd_HH_mm_ss"]
      target => "@timestamp"
      timezone => "America/New_York"
    }

    mutate {
      remove_field => ["[event][original]"]
    }

  } else {

    # Split log_content into multiple lines
    split {
      field => "log_content"
    }

    # Parse the `log_content` field using a grok pattern
    grok {
      match => {
	 "log_content" => "\[%{TIMESTAMP_ISO8601:log_content_timestamp}\](\s*)%{INT:byte_number}(\s*)%{BASE10NUM:data}"
      }
    }

    mutate {
      convert => {
	"data" => "float"
      }
    }

    # If you want to convert `log_timestamp` to a proper @timestamp field
    date {
      match => ["log_content_timestamp", "YYYY-MM-dd HH:mm:ss.SSSSSS"]
      target => "@timestamp"
      timezone => "America/New_York"
    }

    if [log_type] == "quality_log" and [data] {
      mutate {
	rename => { "data" => "quality" }
      }
    }
    else if [log_type] == "power_log" and [data] {
      mutate {
	rename => { "data" => "power" }
      }
    }
    else if [log_type] == "snr_log" and [data] {
      mutate {
	rename => { "data" => "snr" }
      }
    }
    else if [log_type] == "average_quality_log" and [data] {
      mutate {
	rename => { "data" => "average_quality" }
      }
    }
    else if [log_type] == "average_power_log" and [data] {
      mutate {
	rename => { "data" => "average_power" }
      }
    }
    else if [log_type] == "average_snr_log" and [data] {
      mutate {
	rename => { "data" => "average_snr" }
      }
    }

    mutate {
      convert => {
	"receiver_channel" => "integer"
	"transmitter_channel" => "integer"
	"log_timestamp" => "string"
      }
    }


    # Optional: Remove the original log_content field as it's not needed
    mutate {
      remove_field => ["[event][original]", "log_content_timestamp"]
    }
  }
}

output {
  elasticsearch {
    hosts => ["https://192.168.60.201:9200"]
    # API key removed from repository for security. Do NOT commit real keys.
    # Load the real API key from the Logstash keystore or an environment-backed secret at deploy time.
    # Example (recommended): create a Logstash keystore and configure the pipeline to read it, or
    # set an environment variable in your container runtime and inject it without committing to source.
    api_key => "REPLACE_WITH_ELASTIC_API_KEY"
    ssl_certificate_authorities => "/home/elk/elasticsearch/config/certs/http_ca.crt"
    ilm_enabled => true
    index => "channel_sounder_logging"
    action => create
  }

  # stdout { codec => rubydebug }  # For debugging purposes
}
